#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/bistu_auth.sh
AUTH_CONFIG=/etc/bistu_auth.conf
watched_interface=''

# The daemon understands the shell config. Only call it on a private, trusted
# file. Its query prints an empty result for legacy login modes.
configured_interface() {
    [ -f "$AUTH_CONFIG" ] && [ ! -L "$AUTH_CONFIG" ] || return 1
    case $(LC_ALL=C ls -ldn "$AUTH_CONFIG" | awk '{print $3 ":" $1}') in
        0:-r--------|0:-rw-------) ;;
        *) return 1 ;;
    esac
    "$PROG" --print-campus-interface
}

valid_interface() {
    case "$1" in ''|*[!A-Za-z0-9_]*) return 1 ;; esac
}

start_service() {
    local instance
    watched_interface=$(configured_interface) || {
        watched_interface=''
        echo 'bistu-auth: check the root-owned private config and named campus interface.' >&2
        return 1
    }
    instance=legacy
    if [ -n "$watched_interface" ]; then
        valid_interface "$watched_interface" || { watched_interface=''; return 1; }
        instance="campus_$watched_interface"
    fi
    procd_open_instance "$instance"
    procd_set_param command "$PROG" --daemon
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}

service_triggers() {
    [ -n "$watched_interface" ] || return 0
    local event
    for event in interface.update interface.down; do
        procd_add_interface_trigger "$event" "$watched_interface" /etc/init.d/bistu-auth reload "$watched_interface"
    done
}

reload_service() {
    local iface
    case $# in
        0) iface=$(configured_interface) || return 1
           [ -n "$iface" ] || return 0 ;;
        1) iface=$1 ;;
        *) return 1 ;;
    esac
    valid_interface "$iface" || return 1
    # A delayed callback for an old interface cannot wake a replacement.
    procd_send_signal bistu-auth "campus_$iface" USR1
}
